{
  "rewrites": [
    {
      "source": "/site",
      "destination": "https://property-explorer-staging.vercel.app/"
    },
    {
      "source": "/site/:path*",
      "destination": "https://property-explorer-staging.vercel.app/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
