{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter property-explorer build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/pe-site-plan-export.ts": { "maxDuration": 60 },
    "api/pe-terrain-export.ts": { "maxDuration": 60 },
    "api/pe-map-layers.ts": { "maxDuration": 60 },
    "api/pe-share-view.ts": { "maxDuration": 60 },
    "api/pe-share-grant.ts": { "maxDuration": 60 },
    "api/spine.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Content-Type", "value": "image/x-icon" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src 'self' https://js.stripe.com https://*.stripe.com https://hooks.stripe.com https://accounts.google.com; worker-src 'self' blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/api/auth/(.*)", "destination": "/api/auth?upath=$1" },
    { "source": "/api/spine-deep/(.*)", "destination": "/api/spine-deep?upath=$1" },
    { "source": "/api/spine/(.*)", "destination": "/api/spine?upath=$1" },
    { "source": "/api/pe-gtm", "destination": "/api/pe-gtm" },
    { "source": "/api/pe-terrain-export", "destination": "/api/pe-terrain-export" },
    { "source": "/api/pe-site-plan-export", "destination": "/api/pe-site-plan-export" },
    { "source": "/api/pe-topography", "destination": "/api/pe-map-layers?layer=topography" },
    { "source": "/api/pe-hydrology", "destination": "/api/pe-map-layers?layer=hydrology" },
    { "source": "/api/pe-hydrography", "destination": "/api/pe-map-layers?layer=hydrography" },
    { "source": "/api/pe-opportunity-zone", "destination": "/api/pe-map-layers?layer=opportunity-zone" },
    { "source": "/api/pe-geocode", "destination": "/api/pe-geocode" },
    { "source": "/api/pe-situs-search", "destination": "/api/pe-situs-search" },
    { "source": "/api/pe-who-serves", "destination": "/api/pe-who-serves" },
    { "source": "/api/pe-share", "destination": "/api/pe-share" },
    { "source": "/api/pe-share-view", "destination": "/api/pe-share-view" },
    { "source": "/api/pe-share-grant", "destination": "/api/pe-share-grant" },
    { "source": "/api/pe-llms-txt", "destination": "/api/pe-llms-txt" },
    { "source": "/llms.txt", "destination": "/api/pe-llms-txt" },
    { "source": "/s/:grantId", "destination": "/api/pe-share-grant?grantId=:grantId" },
    { "source": "/api/pe-smart-files-mount", "destination": "/api/pe-smart-files-mount" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
